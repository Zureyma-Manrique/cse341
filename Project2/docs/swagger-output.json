      "name": "User Stories",
      "description": "AI-generated agile user stories awaiting review (requires login)"
    },
    {
      "name": "Projects",
      "description": "Projects that group user stories and provide AI context (requires login)"
    }
  ],
  "schemes": [
    "http"
  ],
