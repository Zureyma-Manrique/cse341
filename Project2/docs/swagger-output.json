{
  "swagger": "2.0",
  "info": {
    "title": "Calendar Agent API",
    "description": "Automated Calendar Agent that uses an LLM (Gemini 2.5 Flash) to generate agile user stories from natural-language prompts, pending human review, then syncs approved stories to a calendar.",
