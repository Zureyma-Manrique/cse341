  "definitions": {
    "GeneratePromptRequest": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "example": "Plan a two-week sprint to add user authentication with OAuth login and password reset."
        }
      }
    },
    "UpdateStoryRequest": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "example": "approved"
        },
        "title": {
          "type": "string",
          "example": "Add OAuth login endpoint"
        },
        "description": {
          "type": "string",
          "example": "As a user, I want to log in with Google, so that I skip creating a new password."
        },
        "estimatedHours": {
          "type": "number",
          "example": 8
        },
        "scheduledDate": {
          "type": "string",
          "example": "2026-08-10"
        },
        "projectName": {
          "type": "string",
          "example": "Calendar Agent"
        }
      }
    },
    "CreateProjectRequest": {
      "type": "object",
      "properties": {
        "projectName": {
          "type": "string",
          "example": "Calendar Agent"
        },
        "context": {
          "type": "string",
          "example": "Internal tool that turns sprint planning prompts into scheduled tasks."
        }
      }
    }
